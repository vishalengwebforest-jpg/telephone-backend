#!/usr/bin/env node

/**
 * Module dependencies.
 */

require("dotenv").config()
let app = require('../src/server');
let debug = require('debug')('package-test:server');
let http = require('http');
const { styleText } = require('util')

/**
 * Get port from environment and store in Express.
 */

let runMode = process.env[`PORT_${process.env.RUN_MODE}`]
let port = normalizePort(runMode || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

let server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port, () => {
  console.log(styleText('blue', `🚀  Server listing on `))
  console.log(styleText('green', `  PORT : ${port}`))
  console.log(styleText('green', `  RUN_MODE : ${process.env.RUN_MODE}`))
  console.log(styleText('green', `  BASE_URL : ${process.env[`API_URL_${process.env.RUN_MODE}`]}:${process.env[`PORT_${process.env.RUN_MODE}`]}/`))
});
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  let port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  let bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  let addr = server.address();
  let bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
